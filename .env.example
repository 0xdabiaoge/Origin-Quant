# ---- runtime -------------------------------------------------------------
# paper | live   (live also requires live_trading: true in config AND OQ_LIVE=1)
OQ_MODE=paper

# The second and third locks. Leave at 0 unless you are deliberately going live.
OQ_LIVE=0

OQ_LOG_LEVEL=INFO
# OQ_DB_PATH=data/origin.db
# OQ_DATA_DIR=data
# OQ_CONFIG_DIR=config

# ---- OKX credentials (read-only keys are enough for paper mode) -----------
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
# The demo/live venue selection is config/ base.yaml: venues.okx.demo.

# ---- web security --------------------------------------------------------
# Bearer token required for every non-health endpoint once set.
OQ_API_TOKEN=
# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
OQ_SECRET_KEY=
# Prefer the Argon2 hash; the plaintext form exists only for local experiments.
# python -c "from argon2 import PasswordHasher;print(PasswordHasher().hash('your-password'))"
OQ_ADMIN_PASSWORD_HASH=
OQ_ADMIN_PASSWORD=

# Set to 1, or pass --scheduler, to start the scheduler with `oq serve`.
OQ_SCHEDULER=0
# Loopback bypass is disabled by default. Do not enable behind a reverse proxy.
OQ_ALLOW_LOOPBACK_AUTH=0
OQ_ALLOW_LOCAL_WRITES=0

# ---- optional AI model credentials ----------------------------------------
# AI and automatic paper proposals are disabled until explicitly enabled in
# the admin console. Keep these values private and never commit .env.
OQ_AI_KEY_PRIMARY=
OQ_AI_KEY_REVIEW=

# Optional Telegram risk notifications. Configure recipient privately, then
# explicitly enable delivery in the owner console. Disabled by default.
OQ_NOTIFY_TELEGRAM_TOKEN=
OQ_NOTIFY_TELEGRAM_CHAT_ID=

# ---- optional Telegram risk notifications ---------------------------------
# Disabled until an owner explicitly enables them via the admin API. Only
# event type/time/symbol is sent; do not commit these values or share tokens.
OQ_NOTIFY_TELEGRAM_TOKEN=
OQ_NOTIFY_TELEGRAM_CHAT_ID=

# ---- container image (docker compose only) --------------------------------
# Which published image to run. The release workflow prints the exact tag to
# paste here after every build, e.g. v1.0.3
#   docker compose pull && docker compose up -d
OQ_IMAGE_TAG=latest
